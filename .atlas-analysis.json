  "keyFeatures": [
    "Solutions spanning Advent of Code 2015–2025 (11 years)",
    "Shared `aoc_cj.util` library with grid helpers, data parsers, and priority queue",
    "Full pytest test suite with example-input coverage",
    "Integration with `advent-of-code-data` (aocd) for fetching puzzle inputs",
    "Strict type checking with mypy and formatting/linting with Ruff",
    "Pre-commit hooks enforcing code quality on every commit",
    "CI via GitHub Actions (Python 3.13 & 3.14, codecov, zizmor security analysis)"
  ],
  "publicApiSurface": [
    "aoc_cj.solve(year, day, data) -> tuple[Answer, Answer]",
    "aoc_cj.util.adj_4(p: complex) -> Generator[complex]",
    "aoc_cj.util.adj_8(p: complex) -> Generator[complex]",
    "aoc_cj.util.clamp(n, min_n, max_n) -> int",
    "aoc_cj.util.is_prime(n) -> bool",
    "aoc_cj.util.ints(s) -> Generator[int]",
    "aoc_cj.util.digits(s) -> Generator[int]",
    "aoc_cj.util.floats(s) -> Generator[float]",
    "aoc_cj.util.create_regex_parser(pattern, converter) -> Callable",
    "aoc_cj.util.Point3D — frozen dataclass with parse(), adj()",
    "aoc_cj.util.PriorityQueue[T] — generic min-heap with push/pop/pop_with_priority",
    "aoc_cjYYYY.dayDD.part_1(txt: str) -> int | str | None",
    "aoc_cjYYYY.dayDD.part_2(txt: str) -> int | str | None"
  ]
